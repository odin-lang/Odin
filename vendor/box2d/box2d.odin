// World
@(link_prefix="b2", default_calling_convention="c", require_results)
foreign lib {
	// Cast a capsule mover through the world. This is a special shape cast that handles sliding along
	// other shapes while reducing clipping. The mover capsule is relative to the origin. Near the
	// origin pass b2Pos_zero and a world capsule. Returns the translation fraction at the first hit.
	World_CastMover :: proc(worldId: WorldId, origin: Pos, #by_ptr mover: Capsule, translation: Vec2, filter: QueryFilter) -> f32 ---

	// Cast a ray into the world to collect shapes in the path of the ray. Your callback function
	// controls whether you get the closest point, any point, or n-points.
	// @note The callback function may receive shapes in any order
	// @param worldId The world to cast the ray against
	// @param origin The start point of the ray
	// @param translation The translation of the ray from the start point to the end point
	// @param filter Contains bit flags to filter unwanted shapes from the results
	// @param fcn A user implemented callback function
	// @param context A user context that is passed along to the callback function
	// @return traversal performance counters
	World_CastRay :: proc(worldId: WorldId, origin: Pos, translation: Vec2, filter: QueryFilter, fcn: CastResultCallbackFcn, userContext: rawptr) -> TreeStats ---

	// Cast a ray into the world to collect the closest hit. This is a convenience function. Ignores
	// initial overlap. This is less general than b2World_CastRay() and does not allow for custom
	// filtering.
	World_CastRayClosest :: proc(worldId: WorldId, origin: Pos, translation: Vec2, filter: QueryFilter) -> RayResult ---

	// Cast a shape through the world. Similar to a ray cast except that a shape is cast instead of a
	// point. The proxy points are relative to the origin. Callback points are world positions.
	// @see b2World_CastRay
	World_CastShape :: proc(worldId: WorldId, origin: Pos, #by_ptr proxy: ShapeProxy, translation: Vec2, filter: QueryFilter, fcn: CastResultCallbackFcn, userContext: rawptr) -> TreeStats ---

	// Collide a capsule mover with the world, gathering collision planes that can be fed to
	// b2SolvePlanes. Useful for kinematic character movement. The mover capsule and the resulting
	// planes are relative to the origin.
	World_CollideMover :: proc(worldId: WorldId, origin: Pos, #by_ptr mover: Capsule, filter: QueryFilter, fcn: PlaneResultCallbackFcn, userContext: rawptr) ---

	// Call this to draw shapes and other debug draw data
	World_Draw :: proc(worldId: WorldId, draw: ^DebugDraw) ---

	// Dump memory stats to box2d_memory.txt
	World_DumpMemoryStats :: proc(worldId: WorldId) ---

	// Enable/disable continuous collision between dynamic and static bodies. Generally you should keep
	// continuous collision enabled to prevent fast moving objects from going through static objects.
	// The performance gain from disabling continuous collision is minor.
	// @see b2WorldDef
	World_EnableContinuous :: proc(worldId: WorldId, flag: bool) ---

	// Enable/disable restitution propagation.
	// @see b2WorldDef::enableRestitutionPropagation
	World_EnableRestitutionPropagation :: proc(worldId: WorldId, flag: bool) ---

	// Force SSE2 to be used even when AVX2 is available. This is for testing.
	World_EnableSSE2Fallback :: proc(worldId: WorldId, flag: bool) ---

	// Enable/disable sleep. If your application does not need sleeping, you can gain some performance
	// by disabling sleep completely at the world level.
	// @see b2WorldDef
	World_EnableSleeping :: proc(worldId: WorldId, flag: bool) ---

	// Enable/disable constraint warm starting. Advanced feature for testing. Disabling warm starting
	// greatly reduces stability and provides no performance gain.
	World_EnableWarmStarting :: proc(worldId: WorldId, flag: bool) ---

	// Apply a radial explosion
	// @param worldId The world id
	// @param explosionDef The explosion definition
	World_Explode :: proc(worldId: WorldId, #by_ptr explosionDef: ExplosionDef) ---

	// Get the number of awake bodies.
	World_GetAwakeBodyCount :: proc(worldId: WorldId) -> i32 ---

	// Get the body events for the current time step. The event data is transient. Do not store a
	// reference to this data.
	World_GetBodyEvents :: proc(worldId: WorldId) -> BodyEvents ---

	// Call this to get the world bounds based on the union of all shape bounds.
	World_GetBounds :: proc(worldId: WorldId) -> AABB ---

	// Get contact events for the current time step. The event data is transient. Do not store a
	// reference to this data.
	World_GetContactEvents :: proc(worldId: WorldId) -> ContactEvents ---

	// Get the contact point recycling distance. Usually in meters.
	World_GetContactRecycleDistance :: proc(worldId: WorldId) -> f32 ---

	// Get the contact tuning.
	World_GetContactTuning :: proc(worldId: WorldId, hertz: ^f32, dampingRatio: ^f32, pushSpeed: ^f32) ---

	// Get world counters and sizes
	World_GetCounters :: proc(worldId: WorldId) -> Counters ---

	// Get the gravity vector
	World_GetGravity :: proc(worldId: WorldId) -> Vec2 ---

	// Get the hit event speed threshold. Usually in meters per second.
	World_GetHitEventThreshold :: proc(worldId: WorldId) -> f32 ---

	// Get the joint events for the current time step. The event data is transient. Do not store a
	// reference to this data.
	World_GetJointEvents :: proc(worldId: WorldId) -> JointEvents ---

	// Get max capacity. This can be used with b2WorldDef to avoid run-time allocations and copies
	World_GetMaxCapacity :: proc(worldId: WorldId) -> Capacity ---

	// Get the maximum linear speed. Usually in m/s.
	World_GetMaxLinearSpeed :: proc(worldId: WorldId) -> f32 ---

	// Get the current world performance profile
	World_GetProfile :: proc(worldId: WorldId) -> Profile ---

	// Get the number of iterations used by the restitution solver.
	World_GetRestitutionIterations :: proc(worldId: WorldId) -> i32 ---

	// Get the restitution speed threshold. Usually in meters per second.
	World_GetRestitutionThreshold :: proc(worldId: WorldId) -> f32 ---

	// Get sensor events for the current time step. The event data is transient. Do not store a
	// reference to this data.
	World_GetSensorEvents :: proc(worldId: WorldId) -> SensorEvents ---

	// Write a snapshot of the world's simulation state into a caller-owned buffer. Call once with
	// image == NULL to get the required size, then again with a buffer of at least that size. Must be
	// called at a step boundary.
	// @param worldId The world to snapshot
	// @param image Destination buffer, or NULL to query the size
	// @param capacity Size of image in bytes, ignored when querying
	// @return The number of bytes the snapshot needs. If it exceeds capacity nothing is written.
	//         Returns 0 if the world is mid-step.
	World_GetSnapshot :: proc(worldId: WorldId, image: [^]u8, capacity: i32) -> i32 ---

	// Compute a hash of the simulation state. Use this to detect desyncs, for example in rollback
	// resimulation.
	World_GetStateHash :: proc(worldId: WorldId) -> u64 ---

	// Get the user data pointer.
	World_GetUserData :: proc(worldId: WorldId) -> rawptr ---

	// Get the worker count.
	World_GetWorkerCount :: proc(worldId: WorldId) -> i32 ---

	// Is continuous collision enabled?
	World_IsContinuousEnabled :: proc(worldId: WorldId) -> bool ---

	// Is restitution propagation enabled?
	World_IsRestitutionPropagationEnabled :: proc(worldId: WorldId) -> bool ---

	// Is body sleeping enabled?
	World_IsSleepingEnabled :: proc(worldId: WorldId) -> bool ---

	// World id validation. Provides validation for up to 64K allocations.
	World_IsValid :: proc(id: WorldId) -> bool ---

	// Is constraint warm starting enabled?
	World_IsWarmStartingEnabled :: proc(worldId: WorldId) -> bool ---

	// Overlap test for all shapes that *potentially* overlap the provided AABB. The AABB is relative
	// to the origin, which keeps the test precise far from the world origin in large world mode. Near
	// the origin pass b2Pos_zero and a world AABB.
	World_OverlapAABB :: proc(worldId: WorldId, origin: Pos, aabb: AABB, filter: QueryFilter, fcn: OverlapResultCallbackFcn, userContext: rawptr) -> TreeStats ---

	// Overlap test for all shapes that overlap the provided shape proxy. The proxy points are relative
	// to the origin. Near the origin pass b2Pos_zero and world points.
	World_OverlapShape :: proc(worldId: WorldId, origin: Pos, #by_ptr proxy: ShapeProxy, filter: QueryFilter, fcn: OverlapResultCallbackFcn, userContext: rawptr) -> TreeStats ---

	// This is for internal testing
	World_RebuildStaticTree :: proc(worldId: WorldId) ---

	// Restore a world's simulation state from a snapshot image. The b2WorldId and ids held from this
	// same world stay valid for objects that existed at the snapshot instant. Callbacks and threading
	// configuration are preserved. User data on shapes, bodies, and joints is nulled.
	// @param worldId The world to restore into
	// @param image A snapshot image produced by b2World_GetSnapshot
	// @param size Size of image in bytes
	// @return true on success. On a rejected image (bad magic, version, or layout) the world is left
	//         unchanged. A corrupt payload detected after the rebuild begins returns false and leaves
	//         the world unusable, so the caller must destroy it.
	World_RestoreFromSnapshot :: proc(worldId: WorldId, image: [^]u8, size: i32) -> bool ---

	// Set the contact point recycling distance. Setting this to zero disables contact point recycling.
	// Usually in meters.
	World_SetContactRecycleDistance :: proc(worldId: WorldId, recycleDistance: f32) ---

	// Adjust contact tuning parameters
	// @param worldId The world id
	// @param hertz The contact stiffness (cycles per second)
	// @param dampingRatio The contact bounciness with 1 being critical damping (non-dimensional)
	// @param pushSpeed The maximum contact constraint push out speed (meters per second)
	// @note Advanced feature
	World_SetContactTuning :: proc(worldId: WorldId, hertz: f32, dampingRatio: f32, pushSpeed: f32) ---

	// Register the custom filter callback. This is optional.
	World_SetCustomFilterCallback :: proc(worldId: WorldId, fcn: CustomFilterCallbackFcn, userContext: rawptr) ---

	// Set the friction callback. Passing NULL resets to default.
	World_SetFrictionCallback :: proc(worldId: WorldId, callback: FrictionCallbackFcn) ---

	// Set the gravity vector for the entire world. Box2D has no concept of an up direction and this is
	// left as a decision for the application. Usually in m/s^2.
	// @see b2WorldDef
	World_SetGravity :: proc(worldId: WorldId, gravity: Vec2) ---

	// Adjust the hit event threshold. This controls the collision speed needed to generate a
	// b2ContactHitEvent. Usually in meters per second.
	// @see b2WorldDef::hitEventThreshold
	World_SetHitEventThreshold :: proc(worldId: WorldId, value: f32) ---

	// Set the maximum linear speed. Usually in m/s.
	World_SetMaxLinearSpeed :: proc(worldId: WorldId, maximumLinearSpeed: f32) ---

	// Register the pre-solve and pre-continuous callbacks. This is optional.
	World_SetPreSolveCallback :: proc(worldId: WorldId, preSolveFcn: PreSolveCallbackFcn, preContinuousFcn: PreContinuousCallbackFcn, userContext: rawptr) ---

	// Set the restitution callback. Passing NULL resets to default.
	World_SetRestitutionCallback :: proc(worldId: WorldId, callback: RestitutionCallbackFcn) ---

	// Set the number of iterations used by the restitution solver.
	// @see B2_MAX_RESTITUTION_ITERATIONS
	World_SetRestitutionIterations :: proc(worldId: WorldId, iterations: i32) ---

	// Adjust the restitution threshold. It is recommended not to make this value very small because it
	// will prevent bodies from sleeping. Usually in meters per second.
	// @see b2WorldDef
	World_SetRestitutionThreshold :: proc(worldId: WorldId, value: f32) ---

	// Set the user data pointer.
	World_SetUserData :: proc(worldId: WorldId, userData: rawptr) ---

	// Set the worker count. Must be in the range [1, B2_MAX_WORKERS]
	World_SetWorkerCount :: proc(worldId: WorldId, count: i32) ---

	// Begin recording the world into @p recording. Serializes a snapshot of the current world as the
	// seed, then logs every mutating call. Call at a step boundary, before or after creating bodies.
	// Start before the first step to capture the whole session. No effect if already recording or if
	// the world is locked.
	// @param worldId The world to record
	// @param recording A recording buffer from b2CreateRecording
	World_StartRecording :: proc(worldId: WorldId, recording: ^Recording) ---

	// Simulate a world for one time step. This performs collision detection, integration, and
	// constraint solution.
	// @param worldId The world to simulate
	// @param timeStep The amount of time to simulate, this should be a fixed number. Usually 1/60.
	// @param subStepCount The number of sub-steps, increasing the sub-step count can increase
	// accuracy. Usually 4.
	World_Step :: proc(worldId: WorldId, timeStep: f32, subStepCount: i32) ---

	// Stop recording. The recording buffer keeps its bytes. Save and destroy it yourself.
	// @param worldId The world being recorded
	World_StopRecording :: proc(worldId: WorldId) ---
}

// Compute the convex hull of a set of points. Returns an empty hull if it fails. Some failure
// cases:
// - all points very close together
// - all points on a line
// - less than 3 points
// - more than B2_MAX_POLYGON_VERTICES points
//
// This welds close points and removes collinear points.
// @warning Do not modify a hull once it has been computed
@(require_results)
ComputeHull :: proc "c" (points: []Vec2) -> Hull {
	foreign lib {
		b2ComputeHull :: proc "c" (points: [^]Vec2, count: i32) -> Hull ---
	}
	return b2ComputeHull(raw_data(points), i32(len(points)))
}

// Compute the closest points between two shapes represented as point clouds. b2SimplexCache cache
// is input/output. On the first call set b2SimplexCache.count to zero. The underlying GJK
// algorithm may be debugged by passing in debug simplexes and capacity. You may pass in NULL and 0
// for these.
@(require_results)
ComputeShapeDistance :: proc "c" (#by_ptr input: DistanceInput, cache: ^SimplexCache, simplexes: []Simplex) -> DistanceOutput {
	foreign lib {
		b2ComputeShapeDistance :: proc "c" (#by_ptr input: DistanceInput, cache: ^SimplexCache, simplexes: [^]Simplex, simplexCapacity: i32) -> DistanceOutput ---
	}
	return b2ComputeShapeDistance(input, cache, raw_data(simplexes), i32(len(simplexes)))
}

// Make a proxy with a transform. This is a deep copy of the points.
@(require_results)
MakeOffsetProxy :: proc "c" (points: []Vec2, radius: f32, position: Vec2, rotation: Rot) -> ShapeProxy {
	foreign lib {
		b2MakeOffsetProxy :: proc "c" (points: [^]Vec2, count: i32, radius: f32, position: Vec2, rotation: Rot) -> ShapeProxy ---
	}
	return b2MakeOffsetProxy(raw_data(points), i32(len(points)), radius, position, rotation)
}

// Make a proxy for use in overlap, shape cast, and related functions. This is a deep copy of the
// points.
@(require_results)
MakeProxy :: proc "c" (points: []Vec2, radius: f32) -> ShapeProxy {
	foreign lib {
		b2MakeProxy :: proc "c" (points: [^]Vec2, count: i32, radius: f32) -> ShapeProxy ---
	}
	return b2MakeProxy(raw_data(points), i32(len(points)), radius)
}

// Solves the position of a mover that satisfies the given collision planes.
// @param targetDelta the desired translation from the position used to generate the collision
// planes
// @param planes the collision planes
// @param count the number of collision planes
@(require_results)
SolvePlanes :: proc "c" (targetDelta: Vec2, planes: []CollisionPlane) -> PlaneSolverResult {
	foreign lib {
		b2SolvePlanes :: proc "c" (targetDelta: Vec2, planes: [^]CollisionPlane, count: i32) -> PlaneSolverResult ---
	}
	return b2SolvePlanes(targetDelta, raw_data(planes), i32(len(planes)))
}

// Get the touching contact data for a body.
// @note Box2D uses speculative collision so some contact points may be separated.
// @returns the number of elements filled in the provided array
// @warning do not ignore the return value, it specifies the valid number of elements
@(require_results)
Body_GetContactData :: proc "c" (bodyId: BodyId, contactData: []ContactData) -> []ContactData {
	foreign lib {
		b2Body_GetContactData :: proc "c" (bodyId: BodyId, contactData: [^]ContactData, capacity: i32) -> i32 ---
	}
	n := b2Body_GetContactData(bodyId, raw_data(contactData), i32(len(contactData)))
	return contactData[:n]
}

// Get the joint ids for all joints on this body, up to the provided capacity
// @returns the number of joint ids stored in the user array
@(require_results)
Body_GetJoints :: proc "c" (bodyId: BodyId, jointArray: []JointId) -> []JointId {
	foreign lib {
		b2Body_GetJoints :: proc "c" (bodyId: BodyId, jointArray: [^]JointId, capacity: i32) -> i32 ---
	}
	n := b2Body_GetJoints(bodyId, raw_data(jointArray), i32(len(jointArray)))
	return jointArray[:n]
}

// Get the shape ids for all shapes on this body, up to the provided capacity.
// @returns the number of shape ids stored in the user array
@(require_results)
Body_GetShapes :: proc "c" (bodyId: BodyId, shapeArray: []ShapeId) -> []ShapeId {
	foreign lib {
		b2Body_GetShapes :: proc "c" (bodyId: BodyId, shapeArray: [^]ShapeId, capacity: i32) -> i32 ---
	}
	n := b2Body_GetShapes(bodyId, raw_data(shapeArray), i32(len(shapeArray)))
	return shapeArray[:n]
}

// Fill a user array with chain segment shape ids up to the specified capacity. Returns the actual
// number of segments returned.
@(require_results)
Chain_GetSegments :: proc "c" (chainId: ChainId, segmentArray: []ShapeId) -> []ShapeId {
	foreign lib {
		b2Chain_GetSegments :: proc "c" (chainId: ChainId, segmentArray: [^]ShapeId, capacity: i32) -> i32 ---
	}
	n := b2Chain_GetSegments(chainId, raw_data(segmentArray), i32(len(segmentArray)))
	return segmentArray[:n]
}

// Get the touching contact data for a shape. The provided shapeId will be either shapeIdA or
// shapeIdB on the contact data.
// @note Box2D uses speculative collision so some contact points may be separated.
// @returns the number of elements filled in the provided array
// @warning do not ignore the return value, it specifies the valid number of elements
@(require_results)
Shape_GetContactData :: proc "c" (shapeId: ShapeId, contactData: []ContactData) -> []ContactData {
	foreign lib {
		b2Shape_GetContactData :: proc "c" (shapeId: ShapeId, contactData: [^]ContactData, capacity: i32) -> i32 ---
	}
	n := b2Shape_GetContactData(shapeId, raw_data(contactData), i32(len(contactData)))
	return contactData[:n]
}

// Get the overlap data for a sensor shape computed during the previous world step.
// @param shapeId the id of a sensor shape
// @param visitorIds a user allocated array that is filled with the overlapping shapes (visitors)
// @param capacity the capacity of visitorIds
// @returns the number of elements filled in the provided array
// @warning do not ignore the return value, it specifies the valid number of elements
// @warning overlaps may contain destroyed shapes so use b2Shape_IsValid to confirm each overlap
@(require_results)
Shape_GetSensorData :: proc "c" (shapeId: ShapeId, visitorIds: []ShapeId) -> []ShapeId {
	foreign lib {
		b2Shape_GetSensorData :: proc "c" (shapeId: ShapeId, visitorIds: [^]ShapeId, capacity: i32) -> i32 ---
	}
	n := b2Shape_GetSensorData(shapeId, raw_data(visitorIds), i32(len(visitorIds)))
	return visitorIds[:n]
}

