	// Set the rest length of a distance joint
	// @param jointId The id for a distance joint
	// @param length The new distance joint length
	DistanceJoint_SetRestLength :: proc(jointId: JointId, length: f32) ---

	// Set the spring damping ratio, non-dimensional
	DistanceJoint_SetSpringDampingRatio :: proc(jointId: JointId, dampingRatio: f32) ---

	// Set the force range for the spring.
	DistanceJoint_SetSpringForceRange :: proc(jointId: JointId, lowerForce: f32, upperForce: f32) ---

	// Set the spring stiffness in Hertz
	DistanceJoint_SetSpringHertz :: proc(jointId: JointId, hertz: f32) ---

	// Set the distance joint motor speed, usually in meters per second
	DistanceJoint_SetTargetMotorSpeed :: proc(jointId: JointId, motorSpeed: f32) ---
}

// DynamicTree
@(link_prefix="b2", default_calling_convention="c", require_results)
foreign lib {
	// Cast a swept AABB through the tree. This has performance roughly equal to k * log(n), where k is
	// the number of collisions and n is the number of proxies in the tree.
	// @param tree the dynamic tree to cast through
	// @param input the AABB cast input. The box sweeps from its origin to origin + maxFraction *
	// translation.
	// @param maskBits filter bits: `bool accept = (maskBits & proxy->categoryBits) != 0;`
	// @param callback a callback that is called for each proxy the swept box may hit
	// @param context user context that is passed to the callback
	// @return performance data
	DynamicTree_CastBox :: proc(tree: ^DynamicTree, #by_ptr input: BoxCastInput, maskBits: u64, callback: TreeBoxCastCallbackFcn, userContext: rawptr) -> TreeStats ---

	// Ray cast against the proxies in the tree. This relies on the callback to perform an exact ray
	// cast in the case where the proxy contains a shape. The callback also performs any collision
	// filtering. This has performance roughly equal to k * log(n), where k is the number of collisions
	// and n is the number of proxies in the tree. Bit-wise filtering using mask bits can improve
	// performance in some scenarios. However, this filtering may be approximate, so the user should
	// still apply filtering to results.
	// @param tree the dynamic tree to ray cast
	// @param input the ray cast input data.
	// @param maskBits mask bits used to filter proxies.
	// @param callback a callback that is called for each proxy that is hit by the ray
	// @param context user context that is passed to the callback
	// @return performance data
	DynamicTree_CastRay :: proc(tree: ^DynamicTree, #by_ptr input: RayCastInput, maskBits: u64, callback: TreeRayCastCallbackFcn, userContext: rawptr) -> TreeStats ---

	// Get the ratio of the sum of the internal node areas to the root area.
	DynamicTree_GetAreaRatio :: proc(tree: ^DynamicTree) -> f32 ---

	// Get the number of bytes used by this tree
	DynamicTree_GetByteCount :: proc(tree: ^DynamicTree) -> uint ---

	// Get the category bits on a proxy.
	DynamicTree_GetCategoryBits :: proc(tree: ^DynamicTree, proxyId: i32) -> u64 ---

	// Get the height of the binary tree.
	DynamicTree_GetHeight :: proc(tree: ^DynamicTree) -> i32 ---

	// Get the AABB of a proxy
	DynamicTree_GetProxyBounds :: proc(tree: ^DynamicTree, proxyId: i32) -> AABB ---

	// Get the number of proxies created
	DynamicTree_GetProxyCount :: proc(tree: ^DynamicTree) -> i32 ---

	// Get the bounding box that contains the entire tree
	DynamicTree_GetRootBounds :: proc(tree: ^DynamicTree) -> AABB ---

	// Get proxy user data
	DynamicTree_GetUserData :: proc(tree: ^DynamicTree, proxyId: i32) -> u64 ---

	// Move a proxy to a new AABB by removing and reinserting into the tree.
	DynamicTree_MoveProxy :: proc(tree: ^DynamicTree, proxyId: i32, aabb: AABB) ---

	// Query an AABB for overlapping proxies. The callback is called for each proxy that overlaps the
	// supplied AABB.
	// @return performance data
	DynamicTree_OverlapAABB :: proc(tree: ^DynamicTree, aabb: AABB, maskBits: u64, callback: TreeQueryCallbackFcn, userContext: rawptr) -> TreeStats ---

	// Query an AABB for overlapping proxies. The callback is called for each proxy that overlaps the
	// supplied AABB. No filtering is performed.
	// @return performance data
	DynamicTree_OverlapAABBAll :: proc(tree: ^DynamicTree, aabb: AABB, callback: TreeQueryCallbackFcn, userContext: rawptr) -> TreeStats ---

	// Modify the category bits on a proxy.
	DynamicTree_SetCategoryBits :: proc(tree: ^DynamicTree, proxyId: i32, categoryBits: u64) ---

	// Validate the tree.
	DynamicTree_Validate :: proc(tree: ^DynamicTree) ---
}

// Joint
@(link_prefix="b2", default_calling_convention="c", require_results)
foreign lib {
	// Get the current angular separation error for this joint. Does not consider admissible movement.
	// Radians.
	Joint_GetAngularSeparation :: proc(jointId: JointId) -> f32 ---

	// Get body A id on a joint
	Joint_GetBodyA :: proc(jointId: JointId) -> BodyId ---

	// Get body B id on a joint
	Joint_GetBodyB :: proc(jointId: JointId) -> BodyId ---

	// Is collision allowed between connected bodies?
	Joint_GetCollideConnected :: proc(jointId: JointId) -> bool ---

	// Get the current constraint force for this joint. Usually in Newtons.
	Joint_GetConstraintForce :: proc(jointId: JointId) -> Vec2 ---

	// Get the current constraint torque for this joint. Usually in Newton * meters.
	Joint_GetConstraintTorque :: proc(jointId: JointId) -> f32 ---

	// Get the joint constraint tuning. Advanced feature.
	Joint_GetConstraintTuning :: proc(jointId: JointId, hertz: ^f32, dampingRatio: ^f32) ---

	// Get the force threshold for joint events (Newtons)
	Joint_GetForceThreshold :: proc(jointId: JointId) -> f32 ---

	// Get the current linear separation error for this joint. Does not consider admissible movement.
	// Usually in meters.
	Joint_GetLinearSeparation :: proc(jointId: JointId) -> f32 ---

	// Get the local frame on bodyA
	Joint_GetLocalFrameA :: proc(jointId: JointId) -> Transform ---

	// Get the local frame on bodyB
	Joint_GetLocalFrameB :: proc(jointId: JointId) -> Transform ---

	// Get the torque threshold for joint events (N-m)
	Joint_GetTorqueThreshold :: proc(jointId: JointId) -> f32 ---

	// Get the joint type
	Joint_GetType :: proc(jointId: JointId) -> JointType ---

	// Get the user data on a joint
	Joint_GetUserData :: proc(jointId: JointId) -> rawptr ---

	// Get the world that owns this joint
	Joint_GetWorld :: proc(jointId: JointId) -> WorldId ---

	// Joint identifier validation. Provides validation for up to 64K allocations.
	Joint_IsValid :: proc(id: JointId) -> bool ---

	// Toggle collision between connected bodies
	Joint_SetCollideConnected :: proc(jointId: JointId, shouldCollide: bool) ---

	// Set the joint constraint tuning. Advanced feature.
	// @param jointId the joint
	// @param hertz the stiffness in Hertz (cycles per second)
	// @param dampingRatio the non-dimensional damping ratio (one for critical damping)
	Joint_SetConstraintTuning :: proc(jointId: JointId, hertz: f32, dampingRatio: f32) ---

	// Set the force threshold for joint events (Newtons)
	Joint_SetForceThreshold :: proc(jointId: JointId, threshold: f32) ---

	// Set the local frame on bodyA
	Joint_SetLocalFrameA :: proc(jointId: JointId, localFrame: Transform) ---

	// Set the local frame on bodyB
	Joint_SetLocalFrameB :: proc(jointId: JointId, localFrame: Transform) ---

	// Set the torque threshold for joint events (N-m)
	Joint_SetTorqueThreshold :: proc(jointId: JointId, threshold: f32) ---

	// Set the user data on a joint
	Joint_SetUserData :: proc(jointId: JointId, userData: rawptr) ---

	// Wake the bodies connected to this joint
	Joint_WakeBodies :: proc(jointId: JointId) ---
}

