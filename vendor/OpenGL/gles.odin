package vendor_gl

// GL_ES_VERSION_3_2, not in desktop OpenGL's core profile
impl_BlendBarrier:         proc "c" ()
impl_PrimitiveBoundingBox: proc "c" (minX, minY, minZ, minW, maxX, maxY, maxZ, maxW: f32)

loaded_gles_up_to: [2]int

/*
Load the OpenGL ES entry points up to version `major.minor` (2.0 to 3.2) into the same procedures `load_up_to` fills.

Only names that exist in OpenGL ES are requested. On Android, `eglGetProcAddress` spends one of a few hundred extension slots on every name it does not know.

	gl.load_gles_up_to(3, 2, egl.gl_set_proc_address)
*/
load_gles_up_to :: proc(major, minor: int, set_proc_address: Set_Proc_Address_Type) {
	loaded_gles_up_to = {major, minor}

	switch major*10+minor {
	case 32: load_gles_3_2(set_proc_address); fallthrough
	case 31: load_gles_3_1(set_proc_address); fallthrough
	case 30: load_gles_3_0(set_proc_address); fallthrough
	case 20: load_gles_2_0(set_proc_address)
	}
}

