	RGBColor :: struct #align (2) {
		red:   CF.UInt16,
		green: CF.UInt16,
		blue:  CF.UInt16,
	}

	CMYKColor :: struct #align (2) {
		cyan:    CF.UInt16,
		magenta: CF.UInt16,
		yellow:  CF.UInt16,
		black:   CF.UInt16,
	}

	CMYColor :: struct #align (2) {
		cyan:    CF.UInt16,
		magenta: CF.UInt16,
		yellow:  CF.UInt16,
	}

	HLSColor :: struct #align (2) {
		hue:        CF.UInt16,
