		y:    CF.UInt16,
	}

	GrayColor :: struct #align (2) {
		gray: CF.UInt16,
	}

	Multichannel5Color :: struct #packed {
		components: [5]CF.UInt8,
	}

	Multichannel6Color :: struct #packed {
		components: [6]CF.UInt8,
	}

	Multichannel7Color :: struct #packed {
