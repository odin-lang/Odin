		saturation: CF.UInt16,
	}

	HSVColor :: struct #align (2) {
		hue:        CF.UInt16,
		saturation: CF.UInt16,
		value:      CF.UInt16,
	}

	LabColor :: struct #align (2) {
		L: CF.UInt16,
		a: CF.UInt16,
		b: CF.UInt16,
	}

	LuvColor :: struct #align (2) {
		L: CF.UInt16,
		u: CF.UInt16,
		v: CF.UInt16,
	}

