// Odin-style wrappers for methods with a trailing `^^Error` out-parameter

@(objc_type=MutableMovieTrack, objc_name="insertTimeRange")
MutableMovieTrack_insertTimeRange :: #force_inline proc "c" (self: ^MutableMovieTrack, timeRange: CM.TimeRange, track: ^AssetTrack, startTime: CM.Time, copySampleData: bool) -> (ok: bool, err: ^NS.Error) {
	ok = MutableMovieTrack_insertTimeRange_error(self, timeRange, track, startTime, copySampleData, &err)
	return
}

@(objc_type=MutableMovieTrack, objc_name="appendSampleBuffer")
MutableMovieTrack_appendSampleBuffer :: #force_inline proc "c" (self: ^MutableMovieTrack, sampleBuffer: CM.SampleBufferRef, outDecodeTime: ^CM.Time, outPresentationTime: ^CM.Time) -> (ok: bool, err: ^NS.Error) {
	ok = MutableMovieTrack_appendSampleBuffer_error(self, sampleBuffer, outDecodeTime, outPresentationTime, &err)
	return
}


