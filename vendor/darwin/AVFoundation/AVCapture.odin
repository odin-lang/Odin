// Odin-style wrappers for methods with a trailing `^^Error` out-parameter

@(objc_type=CaptureDevice, objc_name="lockForConfiguration")
CaptureDevice_lockForConfiguration :: #force_inline proc "c" (self: ^CaptureDevice) -> (ok: bool, err: ^NS.Error) {
	ok = CaptureDevice_lockForConfiguration_error(self, &err)
	return
}

@(objc_type=CaptureDevice, objc_name="setTorchModeOnWithLevel")
CaptureDevice_setTorchModeOnWithLevel :: #force_inline proc "c" (self: ^CaptureDevice, torchLevel: cffi.float) -> (ok: bool, err: ^NS.Error) {
	ok = CaptureDevice_setTorchModeOnWithLevel_error(self, torchLevel, &err)
	return
}


