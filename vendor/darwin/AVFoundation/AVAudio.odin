// Odin-style wrappers for methods with a trailing `^^Error` out-parameter

@(objc_type=AudioUnitSampler, objc_name="loadSoundBankInstrumentAtURL")
AudioUnitSampler_loadSoundBankInstrumentAtURL :: #force_inline proc "c" (self: ^AudioUnitSampler, bankURL: ^NS.URL, program: cffi.uint8_t, bankMSB: cffi.uint8_t, bankLSB: cffi.uint8_t) -> (ok: bool, err: ^NS.Error) {
	ok = AudioUnitSampler_loadSoundBankInstrumentAtURL_error(self, bankURL, program, bankMSB, bankLSB, &err)
	return
}

@(objc_type=AudioUnitSampler, objc_name="loadInstrumentAtURL")
AudioUnitSampler_loadInstrumentAtURL :: #force_inline proc "c" (self: ^AudioUnitSampler, instrumentURL: ^NS.URL) -> (ok: bool, err: ^NS.Error) {
	ok = AudioUnitSampler_loadInstrumentAtURL_error(self, instrumentURL, &err)
	return
}

@(objc_type=AudioUnitSampler, objc_name="loadAudioFilesAtURLs")
AudioUnitSampler_loadAudioFilesAtURLs :: #force_inline proc "c" (self: ^AudioUnitSampler, audioFiles: ^NS.Array) -> (ok: bool, err: ^NS.Error) {
	ok = AudioUnitSampler_loadAudioFilesAtURLs_error(self, audioFiles, &err)
	return
}


