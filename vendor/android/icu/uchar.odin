	u_enumCharTypes          :: proc(enumRange: UCharEnumTypeRange, context_: rawptr) --- // API level 31
	u_getCombiningClass      :: proc(c: UChar32) -> u8 --- // API level 31
	u_charDigitValue         :: proc(c: UChar32) -> i32 --- // API level 31
	u_charName               :: proc(code: UChar32, nameChoice: UCharNameChoice, buffer: [^]c.char, bufferLength: i32, pErrorCode: ^UErrorCode) -> i32 --- // API level 31
	u_charFromName           :: proc(nameChoice: UCharNameChoice, name: cstring, pErrorCode: ^UErrorCode) -> UChar32 --- // API level 31
	u_enumCharNames          :: proc(start: UChar32, limit: UChar32, fn: UEnumCharNamesFn, context_: rawptr, nameChoice: UCharNameChoice, pErrorCode: ^UErrorCode) --- // API level 31
	u_getPropertyName        :: proc(property: UProperty, nameChoice: UPropertyNameChoice) -> cstring --- // API level 31
	u_getPropertyEnum        :: proc(alias: cstring) -> UProperty --- // API level 31
	u_getPropertyValueName   :: proc(property: UProperty, value: i32, nameChoice: UPropertyNameChoice) -> cstring --- // API level 31
	u_getPropertyValueEnum   :: proc(property: UProperty, alias: cstring) -> i32 --- // API level 31
	u_isIDStart              :: proc(c: UChar32) -> UBool --- // API level 31
	u_isIDPart               :: proc(c: UChar32) -> UBool --- // API level 31
