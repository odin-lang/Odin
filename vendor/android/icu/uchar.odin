	u_getIntPropertyMaxValue :: proc(which: UProperty) -> i32 --- // API level 31
	u_getNumericValue        :: proc(c: UChar32) -> f64 --- // API level 31
	u_islower                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isupper                :: proc(c: UChar32) -> UBool --- // API level 31
	u_istitle                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isdigit                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isalpha                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isalnum                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isxdigit               :: proc(c: UChar32) -> UBool --- // API level 31
	u_ispunct                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isgraph                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isblank                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isdefined              :: proc(c: UChar32) -> UBool --- // API level 31
	u_isspace                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isJavaSpaceChar        :: proc(c: UChar32) -> UBool --- // API level 31
	u_isWhitespace           :: proc(c: UChar32) -> UBool --- // API level 31
	u_iscntrl                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isISOControl           :: proc(c: UChar32) -> UBool --- // API level 31
	u_isprint                :: proc(c: UChar32) -> UBool --- // API level 31
	u_isbase                 :: proc(c: UChar32) -> UBool --- // API level 31
	u_charDirection          :: proc(c: UChar32) -> UCharDirection --- // API level 31
