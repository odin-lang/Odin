XAVideoDecoderCapabilitiesItf :: ^struct { using itf: ^XAVideoDecoderCapabilitiesItf_ }

XAVideoDecoderCapabilitiesItf_ :: struct {
	GetVideoDecoders:            proc "c" (self: XAVideoDecoderCapabilitiesItf, pNumDecoders: ^XAuint32, pDecoderIds: ^XAuint32) -> XAresult,
	GetVideoDecoderCapabilities: proc "c" (self: XAVideoDecoderCapabilitiesItf, decoderId: XAuint32, pIndex: ^XAuint32, pDescriptor: ^XAVideoCodecDescriptor) -> XAresult,
}

XAVideoEncoderCapabilitiesItf :: ^struct { using itf: ^XAVideoEncoderCapabilitiesItf_ }

XAVideoEncoderCapabilitiesItf_ :: struct {
	GetVideoEncoders:            proc "c" (self: XAVideoEncoderCapabilitiesItf, pNumEncoders: ^XAuint32, pEncoderIds: ^XAuint32) -> XAresult,
	GetVideoEncoderCapabilities: proc "c" (self: XAVideoEncoderCapabilitiesItf, encoderId: XAuint32, pIndex: ^XAuint32, pDescriptor: ^XAVideoCodecDescriptor) -> XAresult,
}

XAVideoEncoderItf :: ^struct { using itf: ^XAVideoEncoderItf_ }

XAVideoEncoderItf_ :: struct {
	SetVideoSettings: proc "c" (self: XAVideoEncoderItf, pSettings: ^XAVideoSettings) -> XAresult,
	GetVideoSettings: proc "c" (self: XAVideoEncoderItf, pSettings: ^XAVideoSettings) -> XAresult,
}

XAMediaContainerInformation :: struct {
	containerType: XAuint32,
	mediaDuration: XAmillisecond,
	numStreams:    XAuint32,
}

XAVideoStreamInformation :: struct {
	codecId:   XAuint32,
	width:     XAuint32,
	height:    XAuint32,
	frameRate: XAuint32,
	bitRate:   XAuint32,
	duration:  XAmillisecond,
}

XAAudioStreamInformation :: struct {
	codecId:     XAuint32,
	channels:    XAuint32,
	sampleRate:  XAmilliHertz,
	bitRate:     XAuint32,
	langCountry: [16]XAchar,
	duration:    XAmillisecond,
}

XAImageStreamInformation :: struct {
	codecId:              XAuint32,
	width:                XAuint32,
	height:               XAuint32,
	presentationDuration: XAmillisecond,
}

XATimedTextStreamInformation :: struct {
	layer:       XAuint16,
	width:       XAuint32,
	height:      XAuint32,
	tx:          XAuint16,
	ty:          XAuint16,
	bitrate:     XAuint32,
	langCountry: [16]XAchar,
	duration:    XAmillisecond,
}

XAMIDIStreamInformation :: struct {
	channels:    XAuint32,
	tracks:      XAuint32,
	bankType:    XAuint32,
	langCountry: [16]XAchar,
	duration:    XAmillisecond,
}

XAVendorStreamInformation :: struct {
	VendorStreamInfo: rawptr,
}

XAStreamInformationItf      :: ^struct { using itf: ^XAStreamInformationItf_ }
xaStreamEventChangeCallback :: proc "c" (caller: XAStreamInformationItf, eventId: XAuint32, streamIndex: XAuint32, pEventData: rawptr, pContext: rawptr)

XAStreamInformationItf_ :: struct {
	QueryMediaContainerInformation: proc "c" (self: XAStreamInformationItf, info: ^XAMediaContainerInformation) -> XAresult,
	QueryStreamType:                proc "c" (self: XAStreamInformationItf, streamIndex: XAuint32, domain: ^XAuint32) -> XAresult,
	QueryStreamInformation:         proc "c" (self: XAStreamInformationItf, streamIndex: XAuint32, info: rawptr) -> XAresult,
	QueryStreamName:                proc "c" (self: XAStreamInformationItf, streamIndex: XAuint32, pNameSize: ^XAuint16, pName: ^XAchar) -> XAresult,
	RegisterStreamChangeCallback:   proc "c" (self: XAStreamInformationItf, callback: xaStreamEventChangeCallback, pContext: rawptr) -> XAresult,
	QueryActiveStreams:             proc "c" (self: XAStreamInformationItf, numStreams: ^XAuint32, activeStreams: ^XAboolean) -> XAresult,
	SetActiveStream:                proc "c" (self: XAStreamInformationItf, streamNum: XAuint32, active: XAboolean, commitNow: XAboolean) -> XAresult,
}

