MotionEvent_Action :: enum u32 {
	BUTTON_PRESS   = 11,
	BUTTON_RELEASE = 12,
	CANCEL         = 3,
	DOWN           = 0,
	HOVER_ENTER    = 9,
	HOVER_EXIT     = 10,
	HOVER_MOVE     = 7,
	MOVE           = 2,
	OUTSIDE        = 4,
	POINTER_DOWN   = 5,
	POINTER_UP     = 6,
	SCROLL         = 8,
	UP             = 1,
}

MotionEvent_Button :: enum u32 {
	BACK             = 3,
	FORWARD          = 4,
	PRIMARY          = 0,
	SECONDARY        = 1,
	STYLUS_PRIMARY   = 5,
	STYLUS_SECONDARY = 6,
	TERTIARY         = 2,
}
MotionEvent_Buttons :: distinct bit_set[MotionEvent_Button; u32]

MotionEvent_EdgeFlag :: enum u32 {
	BOTTOM = 1,
	LEFT   = 2,
	RIGHT  = 3,
	TOP    = 0,
