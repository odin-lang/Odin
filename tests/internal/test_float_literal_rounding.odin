package test_internal

import "core:testing"

@(private="file")
Literal_Case :: struct {
	got, want: f64,
}

@test
test_integer_literal_to_f64 :: proc(t: ^testing.T) {
	cases := [?]Literal_Case{
		{1e25, 1.0e25},
		{1e91, 1.0e91},
		{1e151, 1.0e151},
		{1e193, 1.0e193},
		{1e217, 1.0e217},
		{1e236, 1.0e236},
		{1e244, 1.0e244},
		{-1e25, -1.0e25},
		{13178926230986450909076205558044537159093795760067206394393, 13178926230986451052715257756680845840340565023080535031808.0},
		{171019189876682698145520419019978611804685434057151344047319, 171019189876682708561440895353783597443880936193048421859328.0},
		{1729382256910270785, 1729382256910270720.0},
		{2882303761517117740, 2882303761517117952.0},
		{1993841993677374179443513569218396160, 1993841993677374104503615769773342720.0},
		{9007199254740993, 9007199254740992.0},
		{9007199254740995, 9007199254740996.0},
		{9223372036854775807, 9223372036854775808.0},
		{18446744073709553664, 18446744073709551616.0},
		{18446744073709553665, 18446744073709555712.0},
		{18446744073709557760, 18446744073709559808.0},
		{, 1.7976931348623157e308},
	}
	for c, i in cases {
		testing.expectf(t, transmute(u64)c.got == transmute(u64)c.want, "case %d: got %v, want %v", i, c.got, c.want)
	}
}
