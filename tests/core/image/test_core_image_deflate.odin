expect_png_regression :: proc(t: ^testing.T, name: string, data: []byte) {
	want, want_err := png.load_from_bytes(data)
	defer image.destroy(want)
	testing.expectf(t, want_err == nil, "%v: load_from_bytes returned %v", name, want_err)
	if want_err != nil {
		return
	}
	testing.expectf(t, want.width == 128 && want.height == 128, "%v: loaded %vx%v, expected 128x128", name, want.width, want.height)
	expect_stream_loads(t, name, data, png_context_loader, {}, want, nil)

	for n in 0..<len(data) {
		for kind in Stream_Kind {
			input := data[:n]
			br: bytes.Reader
			tr: Trickle_Reader
			ctx := stream_test_context(kind, &input, &br, &tr)
			img, err := png.load_from_context(&ctx, {}, context.allocator)
			image.destroy(img)
			compress.destroy_context(&ctx)
			testing.expectf(t, err != nil, "%v, %v: truncated to %v of %v bytes loaded without error", name, kind, n, len(data))
		}
	}
}

@(test)
png_deflate_regression :: proc(t: ^testing.T) {
	expect_png_regression(t, "deflate regression 1", PNG_DEFLATE_REGRESSION_1[:])
	expect_png_regression(t, "deflate regression 2", PNG_DEFLATE_REGRESSION_2[:])
}
