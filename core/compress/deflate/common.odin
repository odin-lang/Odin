@(private)
log2 :: proc(n: u32) -> u32 #no_bounds_check {
	if n == 0 { return 0 }
	return 31 - intrinsics.count_leading_zeros(n)
}

@(private)
deflate_round_up_divide :: proc(n, d: i32) -> i32 #no_bounds_check {
	return (n + (d - 1)) / d
}

@(private)
inflate_zlib_header :: proc(z: ^compress.Context) -> (err: Error) {
	header, header_err := compress.read_data(z, [ZLIB_HEADER_SIZE]u8)
	if header_err != nil {
		return General_Error.Stream_Too_Short
	}
	cmf, flg := u32(header[0]), u32(header[1])
	if cmf & 0x0f != 8 {
		return General_Error.Unknown_Compression_Method
	}
	if cmf >> 4 > 7 {
		return ZLIB_Error.Unsupported_Window_Size
	}
	if flg & 0x20 != 0 {
		return ZLIB_Error.FDICT_Unsupported
	}
	if (cmf << 8 | flg) % 31 != 0 {
		return ZLIB_Error.Code_Buffer_Malformed
	}
	return nil
}

@(private)
inflate_stream_init :: proc(r: ^Reader, z: ^compress.Context, format: Format, expected_output_size: int, options: compress.Options, allocator: runtime.Allocator) -> (err: Error) {
	r^ = {}
	r.z         = z
	r.format    = format
	r.allocator = allocator
	r.limit     = -1

	if options.max_output_size < 0 {
		return General_Error.Output_Too_Short
	}
	if options.max_memory < 0 || options.chunk_size < 0 || options.progress_interval < 0 {
		return General_Error.Incompatible_Options
	}
	expected := i64(compress.declared_size(expected_output_size))
	if options.max_output_size > 0 {
		r.limit = i64(options.max_output_size)
	}
	r.declared = expected
	if expected >= 0 {
		if r.limit >= 0 && expected > r.limit {
			return General_Error.Output_Too_Short
		}
		r.limit = expected
	}
	inflate_progress_init(&r.progress, z, expected_output_size, options) or_return

	switch format {
	case .Raw, .Raw64:
	case .Zlib:
		inflate_zlib_header(z) or_return
		r.digest            = 1
		r.progress.bytes_in = ZLIB_HEADER_SIZE
	case .Gzip:
		_, header_size := inflate_gzip_header(z) or_return
		r.progress.bytes_in = i64(header_size)
	}
	inflate_decoder_init(&r.decoder, z)

	history := i64(DEFLATE64_WINDOW_SIZE if format == .Raw64 else DEFLATE_WINDOW_SIZE)
	slack   := i64((DEFLATE64_MATCH_MAX if format == .Raw64 else DEFLATE_MATCH_MAX) + INFLATE_COPY_MARGIN)
	size    := history + i64(options.chunk_size if options.chunk_size > 0 else INFLATE_CHUNK_SIZE) + slack
	sliding := true
	if r.limit >= 0 && r.limit <= size {
		size    = r.limit
		sliding = false
	}
	if options.buffer != nil {
		if sliding || i64(len(options.buffer)) < size {
			size    = i64(len(options.buffer))
			sliding = true
		}
	} else if size > i64(compress.memory_limit(options)) {
		size    = i64(compress.memory_limit(options))
		sliding = true
	}

	r.history    = int(history)
	r.high_water = max(int)
	if sliding {
		if size - slack <= history {
			return General_Error.Incompatible_Options if options.buffer != nil else General_Error.Memory_Limit_Exceeded
		}
		r.high_water = int(size - slack)
	}
	if options.buffer != nil {
		r.window = options.buffer[:size]
	} else {
		r.window      = non_zero_make([]u8, int(size), allocator) or_return
		r.owns_window = true
	}
	return nil
}

@(private)
inflate_stream_fill :: proc(r: ^Reader) -> (err: Error) {
	if r.decoder.state == .Done {
		_, header_size := inflate_gzip_header(r.z) or_return
		r.progress.bytes_in += i64(header_size)
		inflate_decoder_init(&r.decoder, r.z)
		r.written = 0
		r.flushed = 0
		r.member  = 0
		r.digest  = 0
	} else if r.written >= r.high_water {
		keep := min(r.written, r.history)
		copy(r.window, r.window[r.written - keep:r.written])
		r.written = keep
		r.flushed = keep
	}

	from     := r.written
	capacity := len(r.window)
	if r.limit >= 0 && r.limit - r.total < i64(capacity - from) {
		capacity = from + int(r.limit - r.total)
	}
	checksum := Inflate_Checksum.None
	switch r.format {
	case .Raw, .Raw64:
	case .Zlib: checksum = .Adler32
	case .Gzip: checksum = .CRC32
	}

	written: int
	output := r.window[:capacity]
	if compress.is_memory_context(r.z) {
		if r.format == .Raw64 {
			written, err = inflate_decompress(&r.decoder, output, nil, 0, 0, from, r.high_water, checksum, &r.digest, false, true, true)
		} else {
			written, err = inflate_decompress(&r.decoder, output, nil, 0, 0, from, r.high_water, checksum, &r.digest, false, false, true)
		}
	} else {
		if r.format == .Raw64 {
			written, err = inflate_decompress(&r.decoder, output, nil, 0, 0, from, r.high_water, checksum, &r.digest, true, true, true)
		} else {
			written, err = inflate_decompress(&r.decoder, output, nil, 0, 0, from, r.high_water, checksum, &r.digest, true, false, true)
		}
	}
	if inflate_overrun(&r.decoder.s) {
		err     = General_Error.Stream_Too_Short
		written = min(written, r.decoder.s.checkpoint)
	}
	if err == General_Error.Output_Too_Short && r.declared >= 0 {
		err = General_Error.Size_Mismatch
	}
	r.written          = written
	r.total           += i64(written - from)
	r.member          += i64(written - from)
	r.z.bytes_written  = r.total
	if err != nil || r.decoder.state != .Done {
		return
	}
	r.progress.bytes_in += inflate_consumed(&r.decoder.s)

	switch r.format {
	case .Raw, .Raw64:
		r.done = true
	case .Zlib:
		adler, adler_err := compress.read_data(r.z, u32be)
		if adler_err != nil {
			return General_Error.Stream_Too_Short
		}
		r.progress.bytes_in += size_of(u32be)
		if r.digest != u32(adler) {
			return General_Error.Checksum_Failed
		}
		r.done = true
	case .Gzip:
		trailer, trailer_err := compress.read_data(r.z, Gzip_Trailer)
		if trailer_err != nil {
			return General_Error.Stream_Too_Short
		}
		r.progress.bytes_in += size_of(Gzip_Trailer)
		if u32le(r.digest) != trailer.crc32 {
			return GZIP_Error.Payload_CRC_Invalid
		}
		if u32le(u32(r.member)) != trailer.size {
			return GZIP_Error.Payload_Length_Invalid
		}
		magic, magic_err := compress.peek_data(r.z, Gzip_Magic)
		r.done = magic_err != nil || magic != .GZIP
	}
	if r.done && r.declared >= 0 && r.total != r.declared {
		return General_Error.Size_Mismatch
	}
	return
}

@(private)
inflate_stream_to_writer :: proc(w: io.Writer, z: ^compress.Context, format: Format, expected_output_size: int, options: compress.Options, allocator: runtime.Allocator) -> (err: Error) {
	r: Reader
	defer reader_destroy(&r)
	inflate_stream_init(&r, z, format, expected_output_size, options, allocator) or_return
	for !r.done {
		fill_err := inflate_stream_fill(&r)
		produced := r.written > r.flushed
		if produced {
			_, write_err := io.write_full(w, r.window[r.flushed:r.written])
			if write_err != nil {
				return write_err
			}
			r.flushed = r.written
		}
		if fill_err != nil {
			return fill_err
		}
		if produced || r.done {
			inflate_reader_progress(&r) or_return
		}
	}
	return nil
}

@(private)
inflate_consumed :: #force_inline proc "contextless" (s: ^Inflate) -> (consumed: i64) {
	return s.base + i64(min(s.position - int(s.bit_count >> 3), len(s.input)))
}

@(private)
inflate_progress_init :: proc(p: ^Inflate_Progress, z: ^compress.Context, expected_output_size: int, options: compress.Options) -> (err: Error) {
	p^ = {options = options, total_in = -1, total_out = -1, next = max(i64)}
	if options.progress_interval < 0 {
		return General_Error.Incompatible_Options
	}
	if options.progress == nil {
		return nil
	}
	p.total_in  = i64(compress.input_size(z))
	p.total_out = i64(compress.declared_size(expected_output_size))
	p.next = i64(compress.progress_interval(options))
	return nil
}

@(private)
inflate_progress_step :: proc(p: ^Inflate_Progress, bytes_in, bytes_out: i64) -> (err: Error) {
	if bytes_out < p.next {
		return nil
	}
	compress.report_progress(p.options, bytes_in, bytes_out, p.total_in, p.total_out) or_return
	interval := i64(compress.progress_interval(p.options))
	p.next = bytes_out + interval if interval < max(i64) - bytes_out else max(i64)
	return nil
}

@(private)
inflate_progress_mark :: proc "contextless" (p: ^Inflate_Progress) -> (mark: int) {
	return int(clamp(p.next - p.start, 0, i64(max(int))))
}

@(private, cold)
inflate_progress_block :: #force_no_inline proc(d: ^Inflate_Decoder, consumed: i64, written: int) -> (err: Error) {
	p := d.progress
	inflate_progress_step(p, p.bytes_in + consumed, p.start + i64(written)) or_return
	d.mark = inflate_progress_mark(p)
	return nil
}

@(private)
inflate_reader_progress :: proc(r: ^Reader) -> (err: Error) {
	bytes_in := r.progress.bytes_in
	if r.decoder.state != .Done {
		bytes_in += inflate_consumed(&r.decoder.s)
	}
	return compress.report_progress(r.progress.options, bytes_in, r.total - i64(r.written - r.flushed), r.progress.total_in, r.progress.total_out)
}
