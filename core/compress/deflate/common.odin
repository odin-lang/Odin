@(private)
log2 :: proc(n: u32) -> u32 #no_bounds_check {
	if n == 0 { return 0 }
	return 31 - intrinsics.count_leading_zeros(n)
}

@(private)
deflate_round_up_divide :: proc(n, d: i32) -> i32 #no_bounds_check {
	return (n + (d - 1)) / d
}
