/*
Deflate compression and decompression implementation, following RFC 1950 (zlib), RFC 1951 (DEFLATE),
and RFC 1952 (gzip).

This is a hardened, extended, and optimized port of Micha Mettke's `sinfl.h` + `sdefl.h`,
which we based this work on, with thanks.

We also incorporate some additional speedups from [zlib-ng](https://github.com/zlib-ng/zlib-ng).
Its license is the same as Odin's: ZLib, and can be found in this package as `LICENSE-zlib-ng.md`.
*/
package compress_deflate

/*
	Copyright 2026 Jeroen van Rijn <nom@duclavier.com>.
	Made available under Odin's license.

	List of contributors:
		Jeroen van Rijn: Initial implementation, optimization.

		Thanks to Micha Mettke (vurtun), and the zlib-ng contributors.
*/

import "base:intrinsics"
import "base:runtime"
import "core:compress"
import "core:io"

// `SMALL_INPUT_OPTIMIZATIONS` improves compression on inputs smaller than about 1kiB,
// at the cost of compression speed, especially on Apple silicon, so it's not enabled by default.
SMALL_INPUT_OPTIMIZATION :: #config(SMALL_INPUT_OPTIMIZATION, false)

Error         :: compress.Error
General_Error :: compress.General_Error
Deflate_Error :: compress.Deflate_Error
ZLIB_Error    :: compress.ZLIB_Error
GZIP_Error    :: compress.GZIP_Error

DEFLATE_RAW_BLOCK_SIZE :: 65535
DEFLATE_BLOCK_MAX      :: DEFLATE_RAW_BLOCK_SIZE
DEFLATE_INPUT_MAX      :: max(int) - (max(int) >> 8)
DEFLATE_SLIDE_SIZE     :: 1 << 30
DEFLATE_LOOKAHEAD      :: DEFLATE_MATCH_MIN + 1
DEFLATE_CHUNK_SIZE     :: 256 * 1024

DEFLATE_DISTANCE_MAX     :: 1 << 15
DEFLATE_WINDOW_SIZE      :: DEFLATE_DISTANCE_MAX
DEFLATE_WINDOW_MASK      :: DEFLATE_WINDOW_SIZE - 1

DEFLATE_HASH_BITS        :: 15
DEFLATE_HASH_SIZE        :: 1 << DEFLATE_HASH_BITS
DEFLATE_HASH_MASK        :: DEFLATE_HASH_SIZE - 1
DEFLATE_HASH_SLIDE       :: 32000
DEFLATE_HASH_SLIDE_AT    :: DEFLATE_WINDOW_SIZE - 1 + DEFLATE_HASH_SLIDE

DEFLATE_MATCH_MIN        :: 4
DEFLATE_MATCH3_MIN       :: 3
DEFLATE_SEQUENCE_SIZE    :: 2 * DEFLATE_BLOCK_MAX / (DEFLATE_MATCH3_MIN + 1) + 3

DEFLATE_HASH3_BITS       :: 12
DEFLATE_HASH3_SIZE       :: 1 << DEFLATE_HASH3_BITS
DEFLATE_MATCH3_DISTANCE  :: 4096
DEFLATE_MATCH3_MARGIN    :: 2

DEFLATE_SPLIT_SEGMENTS   :: 16

DEFLATE64_DISTANCE_MAX   :: 1 << 16
DEFLATE64_WINDOW_SIZE    :: DEFLATE64_DISTANCE_MAX
DEFLATE64_WINDOW_MASK    :: DEFLATE64_WINDOW_SIZE - 1
DEFLATE64_MATCH_MAX      :: 65538
DEFLATE64_LONG_MATCH     :: 258
DEFLATE64_DISTANCE_LIMIT :: DEFLATE64_DISTANCE_MAX + 1
DEFLATE64_HASH_BITS      :: 16
DEFLATE64_HASH_SIZE      :: 1 << DEFLATE64_HASH_BITS
DEFLATE64_HASH_SLIDE     :: 1 << 30
DEFLATE64_HASH_SLIDE_AT  :: DEFLATE64_WINDOW_SIZE - 1 + DEFLATE64_HASH_SLIDE

DEFLATE_LITERAL_SYMBOLS  :: 288
DEFLATE_DISTANCE_SYMBOLS :: 32
DEFLATE_PRECODE_SYMBOLS  :: 19

Deflate_Level :: enum i32 {
	Stored  = 0,
	Level_1 = 1,
	Level_2 = 2,
	Level_3 = 3,
	Level_4 = 4,
	Level_5 = 5,
	Level_6 = 6,
	Level_7 = 7,
	Level_8 = 8,
	Level_9  = 9,
	Level_10 = 10,
	Fastest  = Level_1,
	Default  = Level_6,
	Best     = Level_10,
}

DEFLATE_LEVEL_LAZY :: Deflate_Level.Level_6

Deflate_Frequency :: struct {
	literal:  [DEFLATE_LITERAL_SYMBOLS]u32,
	distance: [DEFLATE_DISTANCE_SYMBOLS]u32,
}
Deflate_Code_Words :: struct {
	literal:  [DEFLATE_LITERAL_SYMBOLS]u32,
	distance: [DEFLATE_DISTANCE_SYMBOLS]u32,
}
Deflate_Lengths :: struct {
	literal:  [DEFLATE_LITERAL_SYMBOLS]u8,
	distance: [DEFLATE_DISTANCE_SYMBOLS]u8,
}
Deflate_Codes :: struct {
	words:   Deflate_Code_Words,
	lengths: Deflate_Lengths,
}
Deflate_Sequence :: struct {
	distance, length: i32,
}

// This struct is ~400kiB: allocate it with `new` rather than on the stack.
Deflate :: struct {
	bit_buffer:    u64,
	bit_count:     i32,
	position:      i32,
	hash_base:     i32,
	last_distance: i32,
	hash_head:     [DEFLATE_HASH_SIZE]u16,
	hash_chain:    [DEFLATE_WINDOW_SIZE]u16,

	sequence_count: i32,
	sequences:      [DEFLATE_SEQUENCE_SIZE]Deflate_Sequence,
	frequencies:    Deflate_Frequency,
	codes:          Deflate_Codes,
	hash3_head:     [DEFLATE_HASH3_SIZE]u16,
}

// This struct is ~800kiB: allocate it with `new` rather than on the stack.
Deflate64 :: struct {
	bit_buffer:    u64,
	bit_count:     i32,
	position:      i32,
	hash_base:     i32,
	last_distance: i32,
	hash_head:     [DEFLATE64_HASH_SIZE]u32,
	hash_chain:    [DEFLATE64_WINDOW_SIZE]u32,

	sequence_count: i32,
	sequences:      [DEFLATE_SEQUENCE_SIZE]Deflate_Sequence,
	frequencies:    Deflate_Frequency,
	codes:          Deflate_Codes,
	hash3_head:     [DEFLATE_HASH3_SIZE]u32,
}

DEFLATE_NO_POSITION              :: -1
DEFLATE_MATCH_MAX                :: 258
DEFLATE_GOOD_MATCH               :: 32
DEFLATE_CODE_LENGTH_MAX          :: 15
DEFLATE_SYMBOL_BITS              :: u32(10)
DEFLATE_SYMBOL_MASK              :: (u32(1) << DEFLATE_SYMBOL_BITS) - u32(1)
DEFLATE_LITERAL_MAX_CODE_LENGTH  :: 14
DEFLATE_DISTANCE_MAX_CODE_LENGTH :: 15
DEFLATE_PRECODE_MAX_CODE_LENGTH  :: 7
DEFLATE_END_OF_BLOCK             :: 256

DEFLATE_COUNT_MAX :: ((DEFLATE_LITERAL_SYMBOLS + 3) / 4 + 3) &~ 3

Deflate_Symbol_Count :: struct {
	items:     i32,
	literals:  i32,
	distances: i32,
}

Deflate_Match_Codes :: struct {
	length_slot, length_code:      i32,
	distance_code, distance_extra: i32,
}

Deflate_Block_Type :: enum {
	Stored,
	Dynamic,
	Fixed,
}

Deflate_Match :: struct {
	distance: i32,
	length:   i32,
}

Format :: enum u8 {Raw, Zlib, Gzip, Raw64}

Writer :: struct {
	w:           io.Writer,
	state:       ^Deflate,
	state64:     ^Deflate64,
	window:      []u8,
	out:         []u8,
	filled:      int,
	out_len:     int,
	total:       i64,
	flushed:     i64,
	digest:      u32,
	err:         Error,
	allocator:   runtime.Allocator,
	options:     compress.Options,
	level:       Deflate_Level,
	format:      Format,
	finished:    bool,
	owns_window: bool,
}

Deflate_To_Slice   :: #type proc(s: ^Deflate,   output, input: []u8, level: Deflate_Level, options: compress.Options) -> (written: int, err: Error)
Deflate64_To_Slice :: #type proc(s: ^Deflate64, output, input: []u8, level: Deflate_Level, options: compress.Options) -> (written: int, err: Error)

INFLATE_PRECODE_TABLE_SIZE  :: 128
INFLATE_LITERAL_TABLE_SIZE :: 1334
INFLATE_DISTANCE_TABLE_SIZE  :: 402
INFLATE_BAD_LITERAL        :: 286
INFLATE_BAD_DISTANCE       :: 31
INFLATE64_BAD_DISTANCE     :: 32

INFLATE_ENTRY_LITERAL     :: u32(1) << 31
INFLATE_ENTRY_END         :: u32(1) << 15
INFLATE_ENTRY_LONG        :: u32(1) << 14
INFLATE_ENTRY_EXCEPTIONAL :: u32(1) << 7
INFLATE_ENTRY_SUBTABLE    :: u32(1) << 6

Inflate_Table_Kind :: enum u8 {Precode, Literal, Literal64, Distance, Distance64}

INFLATE_INITIAL_SIZE_MIN    :: 256
INFLATE_INITIAL_SIZE_MAX    :: 16 * 1024 * 1024
INFLATE_PATTERN_STRIDE      := [8]u8{0, 8, 8, 6, 8, 5, 6, 7}
INFLATE_FAST_MARGIN         :: 2 + DEFLATE_MATCH_MAX + 16 * 3
INFLATE_COPY_MARGIN         :: 16 * 3
INFLATE_CHUNK_SIZE          :: 256 * 1024

ZLIB_HEADER_SIZE :: 2

Inflate_Checksum :: enum u8 {None, Adler32, CRC32}

Inflate :: struct {
	input:      []u8,
	position:   int,
	checkpoint: int,
	base:       i64,
	bit_buffer: u64,
	bit_count:  i32,
	eof:        bool,
	ctx:        ^compress.Context,
}

Inflate_State :: enum u8 {Header, Stored, Copy, Fixed, Dynamic, Block, Done}

Inflate_Progress :: struct {
	options:   compress.Options,
	bytes_in:  i64,
	start:     i64,
	total_in:  i64,
	total_out: i64,
	next:      i64,
}

Inflate_Decoder :: struct {
	literals:     [INFLATE_LITERAL_TABLE_SIZE]u32,
	distances:    [INFLATE_DISTANCE_TABLE_SIZE]u32,
	s:            Inflate,
	stored:       int,
	mark:         int,
	progress:     ^Inflate_Progress,
	last:         i32,
	state:        Inflate_State,
	fixed_loaded: bool,
}

Reader :: struct {
	decoder:     Inflate_Decoder,
	z:           ^compress.Context,
	window:      []u8,
	written:     int,
	flushed:     int,
	high_water:  int,
	history:     int,
	limit:       i64,
	declared:    i64,
	total:       i64,
	member:      i64,
	progress:    Inflate_Progress,
	err:         Error,
	allocator:   runtime.Allocator,
	digest:      u32,
	format:      Format,
	done:        bool,
	owns_window: bool,
}

Inflate_Table_Builder :: struct {
	length: i32,
	count:  i32,
	word:   i32,
	code:   u32,
	sorted: []i16,
}

@(rodata, private)
INFLATE_ONE_HOT := [32]u8{16 = 1}

Gzip_Magic :: enum u16le {
	GZIP = 0x8b << 8 | 0x1f,
}

Gzip_Header :: struct #packed {
	magic:              Gzip_Magic,
	compression_method: Gzip_Compression,
	flags:              Gzip_Header_Flags,
	modification_time:  u32le,
	xfl:                Gzip_Compression_Flags,
	os:                 Gzip_OS,
}
#assert(size_of(Gzip_Header) == 10)

Gzip_Trailer :: struct #packed {
	crc32: u32le,
	size:  u32le,
}
#assert(size_of(Gzip_Trailer) == 8)

Gzip_Header_Flag :: enum u8 {
	// Order is important
	text       = 0,
	header_crc = 1,
	extra      = 2,
	name       = 3,
	comment    = 4,
	reserved_1 = 5,
	reserved_2 = 6,
	reserved_3 = 7,
}
Gzip_Header_Flags :: distinct bit_set[Gzip_Header_Flag; u8]

Gzip_OS :: enum u8 {
	FAT          = 0,
	Amiga        = 1,
	VMS          = 2,
	Unix         = 3,
	VM_CMS       = 4,
	Atari_TOS    = 5,
	HPFS         = 6,
	Macintosh    = 7,
	Z_System     = 8,
	CP_M         = 9,
	TOPS_20      = 10,
	NTFS         = 11,
	QDOS         = 12,
	Acorn_RISCOS = 13,
	_Unknown     = 14,
	Unknown      = 255,
}
GZIP_OS_NAME :: #sparse[Gzip_OS]string{
	._Unknown     = "",
	.FAT          = "FAT",
	.Amiga        = "Amiga",
	.VMS          = "VMS/OpenVMS",
	.Unix         = "Unix",
	.VM_CMS       = "VM/CMS",
	.Atari_TOS    = "Atari TOS",
	.HPFS         = "HPFS",
	.Macintosh    = "Macintosh",
	.Z_System     = "Z-System",
	.CP_M         = "CP/M",
	.TOPS_20      = "TOPS-20",
	.NTFS         = "NTFS",
	.QDOS         = "QDOS",
	.Acorn_RISCOS = "Acorn RISCOS",
	.Unknown      = "Unknown",
}

Gzip_Compression :: enum u8 {
	DEFLATE = 8,
}

Gzip_Compression_Flags :: enum u8 {
	Maximum_Compression = 2,
	Fastest_Compression = 4,
}

GZIP_MAX_PAYLOAD_SIZE :: i64(max(u32le))
GZIP_STRING_MAX       :: 1024

