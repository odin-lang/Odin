/*
Deflate compression and decompression implementation, following RFC 1950 (zlib), RFC 1951 (DEFLATE),
and RFC 1952 (gzip).

This is a hardened, extended, and optimized port of Micha Mettke's `sinfl.h` + `sdefl.h`,
which we based this work on, with thanks.
*/
package compress_deflate

/*
	Copyright 2026 Jeroen van Rijn <nom@duclavier.com>.
	Made available under Odin's license.

	List of contributors:
		Jeroen van Rijn: Initial implementation, optimization.
*/

import "base:intrinsics"
import "core:compress"

// `SMALL_INPUT_OPTIMIZATIONS` improves compression on inputs smaller than about 1kiB,
// at the cost of compression speed, especially on Apple silicon, so it's not enabled by default.
SMALL_INPUT_OPTIMIZATION :: #config(SMALL_INPUT_OPTIMIZATION, false)

Error         :: compress.Error
General_Error :: compress.General_Error
Deflate_Error :: compress.Deflate_Error
ZLIB_Error    :: compress.ZLIB_Error
GZIP_Error    :: compress.GZIP_Error

DEFLATE_RAW_BLOCK_SIZE :: 65535
DEFLATE_BLOCK_MAX      :: DEFLATE_RAW_BLOCK_SIZE
DEFLATE_INPUT_MAX      :: max(int) - (max(int) >> 8)
DEFLATE_SLIDE_SIZE     :: 1 << 30

DEFLATE_DISTANCE_MAX     :: 1 << 15
DEFLATE_WINDOW_SIZE      :: DEFLATE_DISTANCE_MAX
DEFLATE_WINDOW_MASK      :: DEFLATE_WINDOW_SIZE - 1

DEFLATE_HASH_BITS        :: 15
DEFLATE_HASH_SIZE        :: 1 << DEFLATE_HASH_BITS
DEFLATE_HASH_MASK        :: DEFLATE_HASH_SIZE - 1

DEFLATE_MATCH_MIN        :: 4
DEFLATE_MATCH3_MIN       :: 3
DEFLATE_SEQUENCE_SIZE    :: 2 * DEFLATE_BLOCK_MAX / (DEFLATE_MATCH3_MIN + 1) + 3

DEFLATE_HASH3_BITS       :: 12
DEFLATE_HASH3_SIZE       :: 1 << DEFLATE_HASH3_BITS
DEFLATE_MATCH3_DISTANCE  :: 4096
DEFLATE_MATCH3_MARGIN    :: 2

DEFLATE_SPLIT_SEGMENTS   :: 16

DEFLATE_LITERAL_SYMBOLS  :: 288
DEFLATE_DISTANCE_SYMBOLS :: 32
DEFLATE_PRECODE_SYMBOLS  :: 19

Deflate_Level :: enum i32 {
	Stored  = 0,
	Level_1 = 1,
	Level_2 = 2,
	Level_3 = 3,
	Level_4 = 4,
	Level_5 = 5,
	Level_6 = 6,
	Level_7 = 7,
	Level_8 = 8,
	Level_9  = 9,
	Level_10 = 10,
	Fastest  = Level_1,
	Default  = Level_6,
	Best     = Level_10,
}

DEFLATE_LEVEL_LAZY :: Deflate_Level.Level_6

Deflate_Frequency :: struct {
	literal:  [DEFLATE_LITERAL_SYMBOLS]u32,
	distance: [DEFLATE_DISTANCE_SYMBOLS]u32,
}
Deflate_Code_Words :: struct {
	literal:  [DEFLATE_LITERAL_SYMBOLS]u32,
	distance: [DEFLATE_DISTANCE_SYMBOLS]u32,
}
Deflate_Lengths :: struct {
	literal:  [DEFLATE_LITERAL_SYMBOLS]u8,
	distance: [DEFLATE_DISTANCE_SYMBOLS]u8,
}
Deflate_Codes :: struct {
	words:   Deflate_Code_Words,
	lengths: Deflate_Lengths,
}
Deflate_Sequence :: struct {
	distance, length: i32,
}

// This struct is ~540kiB: allocate it with `new` rather than on the stack.
Deflate :: struct {
	bit_buffer, bit_count: i32,
	hash_head:  [DEFLATE_HASH_SIZE]i32,
	hash_chain: [DEFLATE_WINDOW_SIZE]i32,

	sequence_count: i32,
	sequences:      [DEFLATE_SEQUENCE_SIZE]Deflate_Sequence,
	frequencies:    Deflate_Frequency,
	codes:          Deflate_Codes,
	hash3_head:     [DEFLATE_HASH3_SIZE]i32,
}

DEFLATE_NO_POSITION              :: -1
DEFLATE_MATCH_MAX                :: 258
DEFLATE_GOOD_MATCH               :: 32
DEFLATE_CODE_LENGTH_MAX          :: 15
DEFLATE_SYMBOL_BITS              :: u32(10)
DEFLATE_SYMBOL_MASK              :: (u32(1) << DEFLATE_SYMBOL_BITS) - u32(1)
DEFLATE_LITERAL_MAX_CODE_LENGTH  :: 14
DEFLATE_DISTANCE_MAX_CODE_LENGTH :: 15
DEFLATE_PRECODE_MAX_CODE_LENGTH  :: 7
DEFLATE_END_OF_BLOCK             :: 256

DEFLATE_COUNT_MAX :: ((DEFLATE_LITERAL_SYMBOLS + 3) / 4 + 3) &~ 3

Deflate_Symbol_Count :: struct {
	items:     i32,
	literals:  i32,
	distances: i32,
}

Deflate_Match_Codes :: struct {
	length_slot, length_code:      i32,
	distance_code, distance_extra: i32,
}

Deflate_Block_Type :: enum {
	Stored,
	Dynamic,
	Fixed,
}

Deflate_Match :: struct {
	distance: i32,
	length:   i32,
}

Deflate_To_Slice :: #type proc(s: ^Deflate, output, input: []u8, level: Deflate_Level) -> (written: int, err: Error)

INFLATE_PRECODE_TABLE_SIZE  :: 128
INFLATE_LITERAL_TABLE_SIZE :: 1334
INFLATE_DISTANCE_TABLE_SIZE  :: 402
INFLATE_BAD_LITERAL        :: 286
INFLATE_BAD_DISTANCE       :: 31

INFLATE_EXPANSION_MAX       :: 1032
INFLATE_INITIAL_SIZE_MIN    :: 256
INFLATE_INITIAL_SIZE_MAX    :: 16 * 1024 * 1024
INFLATE_STREAM_INITIAL_SIZE :: 64 * 1024
INFLATE_GROWTH_STEP         :: 16 * 1024 * 1024

Inflate :: struct {
	input:      []u8,
	position:   int,
	bit_buffer: u64,
	bit_count:  i32,
	eof:        bool,
	ctx:        ^compress.Context,

	literals:  [INFLATE_LITERAL_TABLE_SIZE]u32,
	distances: [INFLATE_DISTANCE_TABLE_SIZE]u32,
}

Inflate_Table_Builder :: struct {
	length: i32,
	count:  i32,
	word:   i32,
	sorted: []i16,
}

Gzip_Magic :: enum u16le {
	GZIP = 0x8b << 8 | 0x1f,
}

Gzip_Header :: struct #packed {
	magic:              Gzip_Magic,
	compression_method: Gzip_Compression,
	flags:              Gzip_Header_Flags,
	modification_time:  u32le,
	xfl:                Gzip_Compression_Flags,
	os:                 Gzip_OS,
}
#assert(size_of(Gzip_Header) == 10)

Gzip_Trailer :: struct #packed {
	crc32: u32le,
	size:  u32le,
}
#assert(size_of(Gzip_Trailer) == 8)

Gzip_Header_Flag :: enum u8 {
	// Order is important
	text       = 0,
	header_crc = 1,
	extra      = 2,
	name       = 3,
	comment    = 4,
	reserved_1 = 5,
	reserved_2 = 6,
	reserved_3 = 7,
}
Gzip_Header_Flags :: distinct bit_set[Gzip_Header_Flag; u8]

Gzip_OS :: enum u8 {
	FAT          = 0,
	Amiga        = 1,
	VMS          = 2,
	Unix         = 3,
	VM_CMS       = 4,
	Atari_TOS    = 5,
	HPFS         = 6,
	Macintosh    = 7,
	Z_System     = 8,
	CP_M         = 9,
	TOPS_20      = 10,
	NTFS         = 11,
	QDOS         = 12,
	Acorn_RISCOS = 13,
	_Unknown     = 14,
	Unknown      = 255,
}
GZIP_OS_NAME :: #sparse[Gzip_OS]string{
	._Unknown     = "",
	.FAT          = "FAT",
	.Amiga        = "Amiga",
	.VMS          = "VMS/OpenVMS",
	.Unix         = "Unix",
	.VM_CMS       = "VM/CMS",
	.Atari_TOS    = "Atari TOS",
	.HPFS         = "HPFS",
	.Macintosh    = "Macintosh",
	.Z_System     = "Z-System",
	.CP_M         = "CP/M",
	.TOPS_20      = "TOPS-20",
	.NTFS         = "NTFS",
	.QDOS         = "QDOS",
	.Acorn_RISCOS = "Acorn RISCOS",
	.Unknown      = "Unknown",
}

Gzip_Compression :: enum u8 {
	DEFLATE = 8,
}

Gzip_Compression_Flags :: enum u8 {
	Maximum_Compression = 2,
	Fastest_Compression = 4,
}

GZIP_MAX_PAYLOAD_SIZE :: i64(max(u32le))
GZIP_STRING_MAX       :: 1024

