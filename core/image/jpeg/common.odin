package jpeg

import "core:compress"
import "core:image"
import "core:simd"

Image   :: image.Image
Error   :: image.Error
Options :: image.Options

Subsampling        :: image.JPEG_Subsampling
Profile            :: image.JPEG_Profile
Entropy_Coding     :: image.JPEG_Entropy_Coding
Lossless_Predictor :: image.JPEG_Lossless_Predictor
Save_Options       :: image.JPEG_Save_Options

DEFAULT_QUALITY     :: 75
DEFAULT_SUBSAMPLING :: Subsampling.S420
DEFAULT_PROFILE     :: Profile.Baseline

THUMBNAIL_PALETTE_SIZE :: 768
BLOCK_SIZE             :: 8
COEFFICIENT_COUNT      :: BLOCK_SIZE * BLOCK_SIZE
SEGMENT_MAX_SIZE       :: 65533
MAX_COMPONENTS         :: 4

@(private)
HUFFMAN_LOOKAHEAD :: 9

@(private)
Huffman_Table :: struct {
	lookup:       [1 << HUFFMAN_LOOKAHEAD]u16,
	max_code:     [17]i32,
	value_offset: [17]i32,
	symbols:      [256]u8,
	defined:      bool,
}

@(private)
Component :: struct {
	id:            u8,
	h, v:          int,
	quant_index:   u8,
	dc_table:      u8,
	ac_table:      u8,
	width, height: int,
	blocks_w:      int,
	blocks_h:      int,
	stride:        int,
	rows:          int,
	coefficients:  []i16,
	quant:         [COEFFICIENT_COUNT]u16,
	quant_latched: bool,
	dc_pred:       i32,
	dc_context:    int,
	plane:         []u8,
	plane16:       []u16,
	plane_stride:  int,
}

@(private)
Reference :: struct {
	id:            u8,
	h, v:          int,
	plane:         []u16,
	width, height: int,
	stride:        int,
	closed:        bool,
}

@(private)
ARITH_DC_BINS :: 158

@(private)
ARITH_AC_BINS :: 245

@(private)
Arith_State :: struct {
	qe:  u32,
	mps: u8,
	lps: u8,
}

Color_Space :: image.JPEG_Color_Space

@(private)
Decoder :: struct {
	ctx:              ^compress.Context,
	bits:             u64,
	count:            u32,
	stopped:          bool,
	huffman:          [2][4]Huffman_Table,
	quant:            [4][COEFFICIENT_COUNT]u16,
	quant_defined:    [4]bool,
	components:       [MAX_COMPONENTS]Component,
	component_count:  int,
	hmax, vmax:       int,
	mcux, mcuy:       int,
	progressive:      bool,
	lossless:         bool,
	wide:             bool,
	precision:        int,
	dc_limit:         int,
	height_from_dnl:  bool,
	restart_interval: int,
	eobrun:           int,
	jfif:             bool,
	adobe:            bool,
	adobe_transform:  u8,
	scans:            int,

	arithmetic:       bool,
	arith_c:          u64,
	arith_a:          u32,
	arith_ct:         u32,
	arith_l:          [4]u8,
	arith_u:          [4]u8,
	arith_kx:         [4]u8,
	dc_stats:         [4][ARITH_DC_BINS]u8,
	ac_stats:         [4][ARITH_AC_BINS]u8,

	hierarchical:     bool,
	differential:     bool,
	hier_lossless:    bool,
	frame_open:       bool,
	expand_h:         bool,
	expand_v:         bool,
	frame_expand_h:   bool,
	frame_expand_v:   bool,
	final_width:      int,
	final_height:     int,
	final_hmax:       int,
	final_vmax:       int,
	references:       [MAX_COMPONENTS]Reference,
	reference_count:  int,
}

