// Odin-style wrappers for methods with a trailing `^^Error` out-parameter

@(objc_type=DateFormatter, objc_name="getObjectValue")
DateFormatter_getObjectValue :: #force_inline proc "c" (self: ^DateFormatter, obj: ^id, string: ^String, rangep: ^_NSRange) -> (ok: bool, err: ^Error) {
	ok = DateFormatter_getObjectValue_error(self, obj, string, rangep, &err)
	return
}


