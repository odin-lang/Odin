	XMLNode_objectsForXQuery_,
}

@(objc_type=XMLNode, objc_name="setStringValue")
XMLNode_setStringValue :: proc {
	XMLNode_setStringValue_resolvingEntities,
	XMLNode_setStringValue_,
}


// Odin-style wrappers for methods with a trailing `^^Error` out-parameter

@(objc_type=XMLNode, objc_name="nodesForXPath")
XMLNode_nodesForXPath :: #force_inline proc "c" (self: ^XMLNode, xpath: ^String) -> (res: ^Array, err: ^Error) {
	res = XMLNode_nodesForXPath_error(self, xpath, &err)
	return
}

@(objc_type=XMLNode, objc_name="objectsForXQuery_constants")
XMLNode_objectsForXQuery_constants :: #force_inline proc "c" (self: ^XMLNode, xquery: ^String, constants: ^Dictionary) -> (res: ^Array, err: ^Error) {
	res = XMLNode_objectsForXQuery_constants_error(self, xquery, constants, &err)
	return
}

@(objc_type=XMLNode, objc_name="objectsForXQuery_")
XMLNode_objectsForXQuery_ :: #force_inline proc "c" (self: ^XMLNode, xquery: ^String) -> (res: ^Array, err: ^Error) {
	res = XMLNode_objectsForXQuery_error(self, xquery, &err)
	return
}
