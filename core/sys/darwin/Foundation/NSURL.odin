// Odin-style wrappers for methods with a trailing `^^Error` out-parameter

@(objc_type=URLConnection, objc_name="sendSynchronousRequest", objc_is_class_method=true)
URLConnection_sendSynchronousRequest :: #force_inline proc "c" (request: ^URLRequest, response: ^^URLResponse) -> (res: ^Data, err: ^Error) {
	res = URLConnection.sendSynchronousRequest_error(request, response, &err)
	return
}


