	@(link_name="IOCatalogueGetData")
	CatalogueGetData :: proc(mainPort: darwin.mach_port_t, flag: cffi.uint32_t, buffer: ^cstring, size: ^cffi.uint32_t) -> darwin.kern_return_t ---

	@(link_name="IOCatalogueModuleLoaded")
	CatalogueModuleLoaded :: proc(mainPort: darwin.mach_port_t, name: ^name_t) -> darwin.kern_return_t ---

	@(link_name="IOCatalogueReset")
