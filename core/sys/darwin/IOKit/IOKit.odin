	@(link_name="IOOpenFirmwarePathMatching")
	OpenFirmwarePathMatching :: proc(mainPort: darwin.mach_port_t, options: cffi.uint32_t, path: cstring) -> CF.MutableDictionaryRef ---

	@(link_name="IORegistryEntryIDMatching")
