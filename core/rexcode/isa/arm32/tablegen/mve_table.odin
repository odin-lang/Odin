// rexcode  ·  Brendan Punsky (dotbmp@github), original author

package rexcode_arm32_tablegen

import lib "../"

// =============================================================================
// MVE -- THE M-PROFILE VECTOR EXTENSION (v8.1-M)
// =============================================================================
//
// A flat list, like THUMB_TABLE, one row per instruction, element type and
// addressing form. Each row was read off llvm-mc: the instruction assembled,
// then each operand varied over its range to find the bits it occupies, which
// had to be the bits of the encoding the row names; every other bit of the
// word is fixed. So the rows are as tight as the architecture's encodings,
// and a word with a should-be-zero bit set does not decode.
//
// VPT is VCMP with a mask -- the same words where VCMP's mask bits are zero
// -- and VPST the same for the predicate already in VPR, VPNOT where its mask
// is zero.

@(rodata)
MVE_TABLE := []lib.Encoding{
	{.VADD, {.QPR, .QPR, .QPR, .NONE, .NONE, .NONE}, {.QD_MVE, .QN_MVE, .QM_MVE, .NONE, .NONE, .NONE}, 0xEF000840, 0xFFF11FF1, .MVE_INT, .T32, {thumb32 = true}, {.I8, .NONE}},
